{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "declaration": true,
    "strict": true,
    "types": ["node"]
  },
  // Паритет с apps/web/tsconfig.json: шаблоны компонентов UI-кита проверяются
  // так же строго, как шаблоны приложения, иначе либа станет дырой в типизации
  "angularCompilerOptions": {
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "strictTemplates": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.spec.ts", "src/**/*.test.ts", "src/test-setup.ts"]
}
