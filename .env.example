# Скопируйте в .env и заполните. Файл .env закоммичен не будет (см. .gitignore).

# Путь к файлу базы SQLite (по умолчанию data/portfolio.sqlite).
# Относительный путь считается от корня проекта, а не от того каталога, из
# которого запущено приложение. Абсолютный путь используется как есть.
# DB_PATH=data/portfolio.sqlite

# Корень проекта. Определяется автоматически (каталог с nx.json), задавать нужно
# только при деплое, где файлов проекта рядом нет.
# APP_ROOT=/opt/investment-portfolio

# Порт бэкенда (по умолчанию 3000)
# PORT=3000

# Токен T-Invest API для импорта операций из Т-Банка.
# Выпускается в приложении Т-Инвестиций: Профиль → Настройки → Т-Invest API →
# «Создать токен». ОБЯЗАТЕЛЬНО выбрать тип «только для чтения» — таким токеном
# нельзя выставлять заявки, приложение только читает список счетов, историю
# операций и справочник инструментов.
# Токен читается только бэкендом и никогда не отдаётся во фронт.
TBANK_TOKEN=

# ВНИМАНИЕ: сертификат *.tbank.ru выпущен корневым центром Минцифры, которого нет
# во встроенном списке корней Node — без него запросы падают на проверке TLS.
# Путь к корневому сертификату задаётся ПЕРЕМЕННОЙ ОКРУЖЕНИЯ ПРИ ЗАПУСКЕ, здесь
# указывать бесполезно: Node читает её при старте, раньше чем приложение загрузит
# этот файл. Подробности и команда — в README, раздел «Импорт из T-Invest API».
#   NODE_EXTRA_CA_CERTS=/путь/к/russian_trusted_root_ca.cer pnpm start:api
